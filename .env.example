# ===== ระบบ Defect Management — คัดลอกเป็น .env แล้วแก้ค่า =====

# คีย์เข้ารหัส session (เปลี่ยนเป็นข้อความสุ่มยาว ๆ)
SECRET_KEY=change-this-to-a-long-random-string

# บัญชีผู้ดูแลระบบ: ชื่อผู้ใช้ ADM เสมอ รหัสผ่านกำหนดตรงนี้
ADMIN_PASSWORD=Test*123
# รหัสกลางสำหรับผู้ใช้ใหม่ / หลัง Admin กดรีเซ็ต
DEFAULT_PASSWORD=Test*123

# ฐานข้อมูล MySQL ใน Docker (docker-compose ใช้สร้างฐานข้อมูล / โปรแกรมใช้เชื่อมต่อ)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_DATABASE=defect_db
MYSQL_USER=defect
MYSQL_PASSWORD=defectpass_change_me

# พอร์ตที่โปรแกรมเปิด (0.0.0.0 = ให้มือถือในวงเดียวกันเข้าได้)
HOST=0.0.0.0
PORT=5100

# ตรวจงานเกินกำหนด / ออก NCR ทุกกี่นาที
CHECK_INTERVAL_MINUTES=10
# วันกำหนดแก้ไขเริ่มต้นในฟอร์ม (นับจากวันนี้)
DEFAULT_DUE_DAYS=7

# ---- AI ตรวจรูป (Gemini) — เว้นว่าง = ปิด AI ----
# ขอ key ได้ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
